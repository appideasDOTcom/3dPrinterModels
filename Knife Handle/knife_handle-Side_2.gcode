M107
; Filament-specific end gcode
;END gcode for filament

M104 S0 ; turn off extruder temperature
M140 S0 ; turn off the heatbed
G91 ; relative positioning
G1 E-1 F300  ; retract the filament a bit before lifting the nozzle, to release some of the pressure
G1 Z+0.5 E-5 X-20 Y-20 F9000 ; move Z up a bit and retract filament even more
; M914 X82 Y82 				; restore stallguard sensitivity settings
G28 X0 Y0 ; Home X and Y - skip Z in case there�{�s an obsstruction
;G28 ; home all axes
;G0 X95.0 Y0.0 ; move X to the middle and Y to HOME, so the head is out of the way
M84 ; steppers off
G90 ; absolute positioning
M300 S160 P500				; Make a noise
; filament used = 9317.1mm (22.4cm3)
; total filament cost = 0.0

